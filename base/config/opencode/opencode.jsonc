{
	"$schema": "https://opencode.ai/config.json",
	"plugins": ["opencode-tool-kagi"],
	"mcp": {
		"servers": {
			"playwright": {
				"type": "local",
				"command": ["npx", "-y", "@playwright/mcp@latest", "--cdp-endpoint", "http://central:3000"]
      },
      "browse": {
        "type": "local",
        "command": [
          "browse",
          "mcp"
        ],
        "cwd": "~",
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      },
      // Remote MCP with OAuth: sign in via /mcps on first use.
      "fibery": {
        "type": "remote",
        "url": "https://mcp.fibery.io/mcp"
      }
		}
	},
	// The memo subagent definition is shared (symlinked from the memo repo); pin its model here.
	"agent": {
		"memo": { "model": "openai/gpt-6-luna" }
	},
	// Kagi is connected via /connect (or KAGI_API_KEY); it replaces websearch/webfetch.
}
