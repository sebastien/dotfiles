#!/usr/bin/env python3

import argparse
import base64
import gzip
import json
import sys
from pathlib import Path

try:
	import msgpack
except ImportError as exc:
	raise SystemExit("msgpack2json: missing Python dependency 'msgpack'") from exc


def load_msgpack(path: Path):
	with path.open("rb") as source:
		payload = source.read()
	if payload[:2] == b"\x1f\x8b":
		payload = gzip.decompress(payload)
	return msgpack.unpackb(payload, raw=False, strict_map_key=False)


def normalize(value):
	if isinstance(value, dict):
		return {str(normalize(key)): normalize(item) for key, item in value.items()}
	if isinstance(value, list):
		return [normalize(item) for item in value]
	if isinstance(value, tuple):
		return [normalize(item) for item in value]
	if isinstance(value, bytes):
		try:
			return value.decode("utf-8")
		except UnicodeDecodeError:
			return {"$binary": base64.b64encode(value).decode("ascii")}
	if isinstance(value, msgpack.ExtType):
		return {"$ext": {"code": value.code, "data": base64.b64encode(value.data).decode("ascii")}}
	return value


def main() -> int:
	parser = argparse.ArgumentParser(
		description="Convert a MessagePack file, optionally gzipped, to JSON"
	)
	parser.add_argument("path", help="path to the MessagePack file")
	args = parser.parse_args()

	data = normalize(load_msgpack(Path(args.path)))
	json.dump(data, sys.stdout, indent=2, sort_keys=True, ensure_ascii=False)
	sys.stdout.write("\n")
	return 0


if __name__ == "__main__":
	raise SystemExit(main())

# EOF
