#!/usr/bin/env python3
"""Module: dedup — Group files by their SHA-256 content hash."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import stat
import sys


def hashFile(path: str) -> str:
	"""Hash `path` without loading the whole file into memory."""
	if not stat.S_ISREG(os.stat(path).st_mode):
		raise OSError("not a regular file")
	digest = hashlib.sha256()
	with open(path, "rb") as source:
		for chunk in iter(lambda: source.read(1024 * 1024), b""):
			digest.update(chunk)
	return digest.hexdigest()


def main() -> int:
	"""Report hash groups for arguments or paths read from stdin."""
	parser = argparse.ArgumentParser(
		description="Group files by SHA-256 hash, including unique files. Never modifies files.",
		epilog="Examples: dedup a.txt b.txt; find . -type f -print0 | dedup -0",
	)
	parser.add_argument("-0", "--null", action="store_true", help="read NUL-separated paths from stdin")
	parser.add_argument("files", nargs="*", help="files to hash (default: one path per stdin line)")
	args = parser.parse_args()
	paths = args.files
	if not paths:
		if sys.stdin.isatty():
			parser.error("provide files or pipe a list of paths on stdin")
		separator = b"\0" if args.null else b"\n"
		paths = [os.fsdecode(path) for path in sys.stdin.buffer.read().split(separator) if path]

	groups: dict[str, list[str]] = {}
	status = 0
	for path in dict.fromkeys(paths):
		try:
			digest = hashFile(path)
		except OSError as error:
			print(f"dedup: {path!r}: {error}", file=sys.stderr)
			status = 1
			continue
		groups.setdefault(digest, []).append(path)

	for digest, files in groups.items():
		print(f"{digest} ({len(files)} {'file' if len(files) == 1 else 'files'})")
		for path in files:
			print(f"  {json.dumps(path)}")
	return status


if __name__ == "__main__":
	sys.exit(main())

# EOF
